/* the shared look: dark screens over the Backdrop, spacing in steps of 8px; Aquire is only for the logo */
.screen {
    --accent: rgb(236, 242, 250);
    --accent-hover: rgb(255, 255, 255);
    --accent-ink: rgb(10, 14, 24);
    flex-grow: 1;
    color: rgb(214, 226, 240);
    -unity-font-definition: url("project://database/Assets/Jonathan/UI/Fonts/Segoe UI.asset");
}

.backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* the ARMADAHEX wordmark and the streak under it; each screen sets the size */
.logo-text {
    padding: 0;
    margin: 0;
    color: rgb(240, 246, 255);
    -unity-font-definition: url("project://database/Assets/Jonathan/UI/Fonts/Aquire Bold.asset");
}

/* a panel with two cut corners, tinted dark, and its outline drawn by a .panel-edge child */
.panel {
    background-image: url("project://database/Assets/Jonathan/UI/Textures/Panel.png");
    -unity-background-image-tint-color: rgba(14, 22, 40, 0.92);
    -unity-slice-left: 28;
    -unity-slice-right: 28;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
}

.panel-edge {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Jonathan/UI/Textures/Panel Edge.png");
    -unity-background-image-tint-color: rgba(200, 220, 255, 0.16);
    -unity-slice-left: 28;
    -unity-slice-right: 28;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
}

/* lines at the corners of a .plate, drawn outside it */
.brackets {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* the main action: a long hex plate in the accent */
.plate {
    overflow: visible;
    margin: 0;
    padding: 0 32px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Jonathan/UI/Textures/Plate.png");
    -unity-background-image-tint-color: var(--accent);
    -unity-slice-left: 44;
    -unity-slice-right: 44;
    -unity-slice-scale: 0.5625px;
    border-width: 0;
    color: var(--accent-ink);
    -unity-font-style: bold;
    transition-duration: 0.15s;
}

.plate:hover {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: var(--accent-hover);
}

.plate:active {
    scale: 0.98 0.98;
}

.plate:disabled {
    -unity-background-image-tint-color: rgb(40, 50, 66);
    color: rgb(120, 140, 165);
}

/* tabs: the picked one underlined in the accent */
.tab {
    flex-grow: 1;
    height: 56px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0 0 2px 0;
    border-radius: 0;
    border-color: rgba(255, 255, 255, 0.08);
    color: rgb(120, 140, 165);
    font-size: 22px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    transition-duration: 0.15s;
}

.tab:hover {
    color: rgb(214, 226, 240);
    background-color: rgba(0, 0, 0, 0);
}

.tab.lit {
    color: rgb(240, 246, 255);
    border-color: var(--accent);
}

/* a page's title, top left under back */
.page-title {
    position: absolute;
    left: 56px;
    top: 128px;
    margin: 0;
    padding: 0;
    color: rgb(240, 246, 255);
    font-size: 40px;
    letter-spacing: 8px;
}

/* a secondary action: an outline that lights on hover */
.outline-button {
    height: 44px;
    margin: 0;
    padding: 0 32px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgb(58, 74, 98);
    border-radius: 3px;
    color: rgb(214, 226, 240);
    font-size: 16px;
    letter-spacing: 4px;
    transition-duration: 0.15s;
}

.outline-button:hover {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--accent);
    color: var(--accent);
}

.outline-button:disabled {
    opacity: 1;
    border-color: rgba(0, 0, 0, 0);
    color: rgb(120, 140, 165);
}

/* a quiet button that is only its word */
.text-button {
    margin: 0;
    padding: 8px 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(120, 140, 165);
    font-size: 16px;
    letter-spacing: 4px;
    transition-duration: 0.15s;
}

.text-button:hover {
    background-color: rgba(0, 0, 0, 0);
    color: var(--accent);
}

/* fields: filled boxes named by their placeholder; focus lights a bar on the left */
.field {
    width: auto;
    margin: 16px 0 0 0;
}

.field > .unity-base-text-field__input {
    height: 64px;
    padding: 0 20px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0 0 0 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    color: rgb(240, 246, 255);
    font-size: 24px;
    transition-duration: 0.15s;
}

.field:focus > .unity-base-text-field__input {
    border-color: var(--accent);
    background-color: rgba(255, 255, 255, 0.09);
}

.field .unity-base-text-field__input--placeholder {
    color: rgb(90, 108, 130);
}

/* a key, drawn as a chip; a KeyLabel inside follows the player's bindings */
.key-chip {
    min-width: 48px;
    margin: 0;
    padding: 3px 10px;
    border-width: 2px;
    border-color: rgb(58, 74, 98);
    border-radius: 3px;
    color: rgb(120, 140, 165);
    font-size: 15px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
}

/* back, top left on every page: its key and the word; on hover the key fills in */
.back {
    position: absolute;
    left: 48px;
    top: 48px;
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.back:hover {
    background-color: rgba(0, 0, 0, 0);
}

.back > .key-chip {
    margin-right: 16px;
}

.back-text {
    padding: 0 0 2px 0;
    margin: 0;
    color: rgb(120, 140, 165);
    font-size: 22px;
    letter-spacing: 4px;
    transition-duration: 0.15s;
}

.back:hover > .key-chip {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
}

.back:hover > .back-text {
    color: var(--accent);
}

.invisible {
    visibility: hidden;
}

.dim {
    color: rgb(120, 140, 165);
}

.accent {
    color: var(--accent);
}

.danger {
    color: rgb(255, 110, 100);
}
