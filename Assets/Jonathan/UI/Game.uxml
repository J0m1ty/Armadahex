<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Theme.uss" />
    <ui:Style src="Game.uss" />
    <ui:VisualElement name="screen" class="screen game" picking-mode="Ignore">

        <ui:VisualElement name="hud" class="fill" picking-mode="Ignore">
            <ui:VisualElement name="youFade" class="side-fade side-fade--left" picking-mode="Ignore" />
            <ui:VisualElement name="enemyFade" class="side-fade side-fade--right" picking-mode="Ignore" />
            <ui:VisualElement name="youClock" class="clock clock--left" picking-mode="Ignore">
                <ui:VisualElement name="youClockFill" class="clock__fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="enemyClock" class="clock clock--right" picking-mode="Ignore">
                <ui:VisualElement name="enemyClockFill" class="clock__fill" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- you: your name and, on your turn, the ship picker and fire -->
            <ui:VisualElement name="you" class="side side--left" picking-mode="Ignore">
                <ui:VisualElement class="side__head" picking-mode="Ignore">
                    <ui:Label text="YOU" class="side__who" picking-mode="Ignore" />
                    <ui:Label name="youName" text="PLAYER" class="side__name" picking-mode="Ignore" />
                    <ui:Label name="youTurn" text="YOUR TURN" class="side__turn side__turn--you" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="controls" class="side__controls" picking-mode="Ignore">
                    <ui:VisualElement name="fleet" class="fleet" picking-mode="Ignore" />
                    <ui:VisualElement class="side__spacer" picking-mode="Ignore" />
                    <ui:Button name="fire" class="plate fire" focusable="false">
                        <ui:Label text="FIRE" class="fire__text" picking-mode="Ignore" />
                        <KeyLabel action="Gameplay/Fire" format="{0}" class="key-chip fire__key" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- the enemy: their name and every shot so far -->
            <ui:VisualElement name="enemy" class="side side--right" picking-mode="Ignore">
                <ui:VisualElement class="side__head" picking-mode="Ignore">
                    <ui:Label text="ENEMY" class="side__who" picking-mode="Ignore" />
                    <ui:Label name="enemyName" text="ENEMY" class="side__name" picking-mode="Ignore" />
                    <ui:Label name="enemyTurn" text="ENEMY TURN" class="side__turn side__turn--enemy" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="feed" class="feed" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- held space: both fleets and how the match is going -->
        <ui:VisualElement name="scoreboard" class="fill shade" picking-mode="Ignore">
            <ui:VisualElement class="board" picking-mode="Ignore">
                <ui:Label name="boardMode" text="PLAYLIST" class="board__mode" picking-mode="Ignore" />
                <ui:VisualElement class="board__cols" picking-mode="Ignore">
                    <ui:VisualElement name="boardYou" class="board__col" picking-mode="Ignore" />
                    <ui:Label text="VS" class="board__vs" picking-mode="Ignore" />
                    <ui:VisualElement name="boardEnemy" class="board__col board__col--right" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- esc -->
        <ui:VisualElement name="matchMenu" class="fill shade match-menu">
            <ui:VisualElement class="match-menu__items">
                <ui:Button name="resume" text="RESUME" class="menu-item" />
                <ui:Button name="skip" text="SKIP TURN" class="menu-item" />
                <ui:Button name="mute" text="MUTE CHAT" class="menu-item" />
                <HoldButton name="surrender" text="SURRENDER" class="menu-item menu-item--danger" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- the intro's cards over its camera moves, and the count into the first turn -->
        <ui:VisualElement name="intro" class="fill intro" picking-mode="Ignore">
            <ui:VisualElement name="introVignette" class="fill intro__vignette" picking-mode="Ignore" />
            <ui:VisualElement name="introCard" class="intro__card" picking-mode="Ignore">
                <ui:Label name="introKicker" class="intro__kicker" picking-mode="Ignore" />
                <ui:Label name="introTitle" class="intro__title" picking-mode="Ignore" />
                <ui:VisualElement class="intro__rule" picking-mode="Ignore" />
                <ui:Label name="introLine" class="intro__line" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="introCount" class="intro__count" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="flash" class="fill flash" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
