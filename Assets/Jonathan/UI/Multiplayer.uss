/* multiplayer: a strip of playlists on the left, a panel fixed to the right that shows the picked one and plays it */
.multiplayer-title {
    position: absolute;
    left: 56px;
    top: 128px;
    margin: 0;
    padding: 0;
    color: rgb(240, 246, 255);
    font-size: 40px;
    letter-spacing: 8px;
}

.back-anchor {
    position: absolute;
    left: 48px;
    top: 48px;
}

.back-anchor > .back {
    position: relative;
    left: 0;
    top: 0;
}

/* the strip runs under the title to the side panel, and scrolls sideways */
.mode-scroll {
    position: absolute;
    left: 0;
    right: 560px;
    top: 216px;
    bottom: 96px;
}

.mode-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    height: 100%;
    padding: 0 56px;
}

.mode-strip {
    flex-direction: row;
    align-items: stretch;
    height: 100%;
}

/* a playlist: a solid frame (its art inside, once it has some), the name at the bottom left */
.mode-card {
    width: 520px;
    margin-right: 24px;
    justify-content: flex-end;
    border-width: 4px;
    border-color: rgb(34, 46, 66);
    background-color: rgb(14, 22, 40);
    -unity-background-scale-mode: scale-and-crop;
    transition-duration: 0.15s;
}

.mode-card:hover {
    border-color: rgb(120, 140, 165);
}

.mode-card.lit {
    border-color: var(--accent);
}

.mode-card__band {
    height: 104px;
    padding: 0 28px 24px 28px;
    justify-content: flex-end;
    background-color: rgba(6, 11, 22, 0.82);
}

.mode-card__name {
    margin: 0;
    padding: 0;
    color: rgb(240, 246, 255);
    font-size: 28px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    white-space: normal;
}

/* the side panel: what's picked up top, how to play it at the bottom */
.side {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 560px;
    padding: 128px 56px 72px 56px;
    justify-content: space-between;
    background-color: rgba(10, 16, 30, 0.94);
    border-left-width: 2px;
    border-color: rgba(200, 220, 255, 0.12);
}

.side-name {
    margin: 0;
    padding: 0;
    color: rgb(240, 246, 255);
    font-size: 40px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    white-space: normal;
}

.side-description {
    margin: 24px 0 0 0;
    padding: 0;
    color: rgb(170, 186, 206);
    font-size: 21px;
    white-space: normal;
}

.side-bottom {
    align-items: stretch;
}

.side .field {
    margin: 0 0 24px 0;
}

.side .play {
    height: 72px;
    font-size: 24px;
    letter-spacing: 8px;
}

/* while it counts down or searches, the play button goes dark and shows the time; an error turns it red */
.side .play.search-busy {
    -unity-background-image-tint-color: rgb(40, 50, 66);
    color: rgb(240, 246, 255);
}

.side .play.search-busy:hover {
    -unity-background-image-tint-color: rgb(58, 72, 94);
}

.side .play.search-error,
.side .play.search-error:disabled {
    -unity-background-image-tint-color: rgb(150, 48, 44);
    color: rgb(255, 235, 232);
    opacity: 1;
}
