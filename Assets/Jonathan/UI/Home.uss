/* the menu's home: the 3D scene behind, the logo and every control down the left, the profile top right */
.menu {
    padding: 0;
    background-color: rgb(6, 10, 18);
}

.home {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.home-logo {
    position: absolute;
    left: 96px;
    top: 96px;
    align-items: flex-start;
}

/* a soft blue light under the logo */
.home-logo__glow {
    position: absolute;
    left: -160px;
    top: -120px;
    right: -160px;
    bottom: -120px;
    background-image: url("project://database/Assets/Jonathan/UI/Textures/Underglow.png");
    -unity-background-image-tint-color: rgba(40, 110, 255, 0.55);
    -unity-background-scale-mode: stretch-to-fill;
}

.home-logo > .logo-text {
    font-size: 88px;
    letter-spacing: 6px;
}

.home-logo > .streak {
    align-self: stretch;
    height: 6px;
    margin-top: -12px;
}

.home-logo__subtitle {
    margin: 10px 0 0 0;
    padding: 0;
    color: rgb(240, 246, 255);
    font-size: 32px;
    letter-spacing: 12px;
}

.home-nav {
    position: absolute;
    left: 72px;
    top: 336px;
    width: 480px;
}

/* a control: its name, and a number on the right for some; lit, it's frosted glass with a glowing edge */
.nav-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    margin: 0 0 8px 0;
    padding: 0 24px;
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 12px;
    -unity-text-align: middle-left;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
}

.nav-item:hover,
.nav-item:focus {
    background-color: rgba(0, 0, 0, 0);
}

.nav-item--small {
    height: 44px;
}

.nav-item__name {
    margin: 0;
    padding: 0;
    color: rgb(230, 238, 248);
    font-size: 24px;
    letter-spacing: 6px;
    transition-duration: 0.15s;
}

.nav-item--small > .nav-item__name {
    font-size: 19px;
    letter-spacing: 5px;
}

.nav-item__detail {
    margin: 0;
    padding: 0;
    color: rgb(190, 204, 222);
    font-size: 17px;
    letter-spacing: 3px;
}

.nav-item:hover > .nav-item__name,
.nav-item:focus > .nav-item__name {
    color: rgb(255, 255, 255);
}

/* the glass: a soft glow around, the blurred scene inside a rounded edge */
.glass__glow {
    position: absolute;
    left: -20px;
    top: -20px;
    right: -20px;
    bottom: -20px;
    opacity: 0;
    background-image: url("project://database/Assets/Jonathan/UI/Textures/Glow.png");
    -unity-background-image-tint-color: rgba(200, 225, 255, 0.55);
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    transition-duration: 0.2s;
}

.glass__frost {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    border-width: 1px;
    border-radius: 12px;
    border-color: rgba(235, 244, 255, 0.85);
    -unity-background-image-tint-color: rgb(100, 110, 128);
    transition-duration: 0.2s;
}

.nav-item:hover > .glass__glow,
.nav-item:focus > .glass__glow,
.profile:hover > .glass__glow,
.profile:focus > .glass__glow {
    opacity: 1;
}

.nav-item:hover > .glass__frost,
.nav-item:focus > .glass__frost {
    opacity: 1;
}

/* the profile: always on glass, the captain's portrait, the player's rank and name, the captain, and a chevron to progression */
.profile {
    position: absolute;
    right: 72px;
    top: 96px;
    flex-direction: row;
    align-items: center;
    width: 520px;
    height: 128px;
    margin: 0;
    padding: 0 28px 0 0;
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 12px;
    -unity-text-align: middle-left;
}

.profile:hover,
.profile:focus {
    background-color: rgba(0, 0, 0, 0);
}

.profile > .glass__frost {
    opacity: 1;
    -unity-background-image-tint-color: rgb(165, 174, 190);
    border-color: rgba(235, 244, 255, 0.3);
}

.profile > .glass__glow {
    -unity-background-image-tint-color: rgba(220, 235, 255, 0.95);
}

.profile:hover > .glass__frost,
.profile:focus > .glass__frost {
    border-color: rgba(255, 255, 255, 1);
}

/* the portrait fills the card's left end, so the card and captain are one surface */
.profile__captain {
    width: 128px;
    height: 128px;
    margin-right: 24px;
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
    overflow: hidden;
}

.profile__portrait {
    flex-grow: 1;
}

.profile__portrait > .captain-initials {
    font-size: 40px;
}

.profile__who {
    flex-grow: 1;
}

.profile__title {
    flex-direction: row;
    align-items: center;
}

.profile__rank {
    margin: 0 12px 0 0;
    padding: 0;
    color: rgb(120, 180, 255);
    font-size: 26px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.profile__name {
    margin: 0;
    padding: 0;
    color: rgb(255, 255, 255);
    font-size: 26px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.profile__line {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.profile__line-name {
    margin: 0 10px 0 0;
    padding: 0;
    color: rgb(200, 212, 228);
    font-size: 16px;
    letter-spacing: 3px;
}

.profile__line-value {
    margin: 0;
    padding: 0;
    color: rgb(255, 255, 255);
    font-size: 16px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

/* two strokes turned into a > */
.profile__chevron {
    width: 14px;
    height: 14px;
    margin-left: 16px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-color: rgb(230, 238, 248);
    rotate: 45deg;
    transition-duration: 0.15s;
}

.profile:hover > .profile__chevron,
.profile:focus > .profile__chevron {
    translate: 4px 0;
    border-color: rgb(255, 255, 255);
}
