/* the menu's home: the 3D scene behind, the logo and every control down the left, the profile top right */
.menu {
    padding: 0;
    background-color: rgb(6, 10, 18);
}

.home {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.home-logo {
    position: absolute;
    left: 96px;
    top: 96px;
    align-items: flex-start;
}

/* a soft blue light under the logo */
.home-logo__glow {
    position: absolute;
    left: -220px;
    top: -110px;
    right: -260px;
    bottom: -130px;
    background-image: url("project://database/Assets/Jonathan/UI/Textures/Underglow.png");
    -unity-background-image-tint-color: rgba(50, 120, 255, 0.4);
    -unity-background-scale-mode: stretch-to-fill;
}

.home-logo > .logo-text {
    font-size: 88px;
    letter-spacing: 6px;
}

.home-logo > .streak {
    align-self: stretch;
    height: 6px;
    margin-top: -12px;
}

.home-logo__subtitle {
    margin: 10px 0 0 0;
    padding: 0;
    color: rgb(240, 246, 255);
    font-size: 32px;
    letter-spacing: 12px;
}

.home-nav {
    position: absolute;
    left: 72px;
    top: 336px;
    width: 480px;
}

/* a control: its name, and a number on the right for some; lit, it's frosted glass with a glowing edge */
.nav-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    margin: 0 0 8px 0;
    padding: 0 24px;
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 12px;
    -unity-text-align: middle-left;
}

.nav-item:hover,
.nav-item:focus {
    background-color: rgba(0, 0, 0, 0);
}

.nav-item__name {
    margin: 0;
    padding: 0;
    color: rgb(230, 238, 248);
    font-size: 24px;
    letter-spacing: 6px;
    transition-duration: 0.15s;
}

.nav-item__detail {
    margin: 0;
    padding: 0;
    color: rgb(190, 204, 222);
    font-size: 17px;
    letter-spacing: 3px;
}

.nav-item.selected > .nav-item__name {
    color: rgb(255, 255, 255);
}

/* the glass: a soft glow around, the blurred scene inside a rounded edge */
.glass__glow {
    position: absolute;
    left: -20px;
    top: -20px;
    right: -20px;
    bottom: -20px;
    opacity: 0;
    background-image: url("project://database/Assets/Jonathan/UI/Textures/Glow.png");
    -unity-background-image-tint-color: rgba(200, 225, 255, 0.22);
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    transition-duration: 0.2s;
}

.glass__frost {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    border-width: 1px;
    border-radius: 12px;
    border-color: rgba(235, 244, 255, 0.6);
    background-color: rgba(150, 185, 255, 0.08);
    -unity-background-image-tint-color: rgb(100, 110, 128);
    transition-duration: 0.2s;
}

.nav-item.selected > .glass__glow {
    opacity: 1;
}

.nav-item.selected > .glass__frost {
    opacity: 1;
}

/* the profile: on glass, the active captain with their name on the portrait's foot, the player's name, rank and experience,
   and a chevron into progression; pointing at it lights the edge */
.profile {
    position: absolute;
    right: 72px;
    top: 96px;
    flex-direction: row;
    align-items: center;
    width: 560px;
    height: 152px;
    margin: 0;
    padding: 16px 32px 16px 16px;
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 14px;
    -unity-text-align: middle-left;
}

.profile:hover,
.profile:focus {
    background-color: rgba(0, 0, 0, 0);
}

.profile > .glass__glow {
    display: none;
}

.profile > .glass__frost {
    opacity: 1;
    border-radius: 14px;
    border-width: 1px;
    background-color: rgba(150, 185, 255, 0.07);
    border-color: rgba(235, 244, 255, 0.18);
    -unity-background-image-tint-color: rgb(165, 174, 190);
    transition-duration: 0.2s;
}

.profile:hover > .glass__frost {
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

.profile__avatar {
    width: 120px;
    height: 120px;
    margin-right: 28px;
    overflow: visible;
}

.profile__captain {
    flex-grow: 1;
    border-radius: 8px;
    overflow: hidden;
}

.profile__portrait {
    flex-grow: 1;
}

.profile__portrait > .captain-initials {
    font-size: 40px;
}

.profile__who {
    flex-grow: 1;
}

.profile__name {
    margin: 0;
    padding: 0;
    color: rgb(255, 255, 255);
    font-size: 32px;
    -unity-font-style: bold;
}

.profile__meta {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

/* the rank's insignia, one gold bar for the first rank */
.profile__pip {
    width: 18px;
    height: 5px;
    margin-right: 10px;
    border-radius: 1px;
    background-color: rgb(255, 194, 61);
}

.profile__rank {
    margin: 0 16px 0 0;
    padding: 0;
    color: rgb(255, 214, 120);
    font-size: 16px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.profile__xp {
    margin: 0;
    padding: 0;
    color: rgb(170, 186, 206);
    font-size: 16px;
    letter-spacing: 2px;
}

/* a tall chevron drawn from two strokes; pointing at the card slides it on and a second one fades in behind: >> */
.profile__chevrons {
    width: 30px;
    height: 40px;
}

.chevron {
    position: absolute;
    left: 8px;
    top: 0;
    width: 14px;
    height: 40px;
    transition-duration: 0.25s;
}

.chevron__stroke {
    position: absolute;
    left: 5px;
    width: 3px;
    height: 23px;
    border-radius: 2px;
    background-color: rgb(200, 212, 228);
    transition-duration: 0.25s;
}

.chevron__stroke--top {
    top: -1px;
    rotate: -31deg;
}

.chevron__stroke--bottom {
    top: 18px;
    rotate: 31deg;
}

.chevron--echo {
    opacity: 0;
}

.profile:hover .chevron {
    translate: 8px 0;
}

.profile:hover .chevron--echo {
    opacity: 0.45;
    translate: -4px 0;
}

.profile:hover .chevron__stroke {
    background-color: rgb(255, 255, 255);
}

/* the changelog: a titled bar, then the updates floating under it, fading in and out at the edges as they scroll */
.changelog {
    position: absolute;
    right: 72px;
    top: 280px;
    bottom: 96px;
    width: 560px;
}

.changelog__heading {
    margin: 0;
    padding: 0 20px;
    height: 48px;
    border-width: 1px 1px 0 1px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-color: rgba(235, 244, 255, 0.18);
    background-image: url("project://database/Assets/Jonathan/UI/Textures/Edge Shade.png");
    -unity-background-scale-mode: stretch-to-fill;
    color: rgb(240, 246, 255);
    font-size: 16px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.changelog__scroll {
    flex-grow: 1;
}

/* the picture hangs under the bar, its foot rounded like the bar's head */
.changelog__image {
    height: 300px;
    margin-bottom: 20px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    overflow: hidden;
}

.changelog__image > FadeImage {
    flex-grow: 1;
}

.changelog__title {
    margin: 0;
    padding: 0;
    color: rgb(255, 255, 255);
    font-size: 26px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    white-space: normal;
}

.changelog__version {
    margin: 6px 0 14px 0;
    padding: 0;
    color: rgb(120, 180, 255);
    font-size: 14px;
    letter-spacing: 3px;
}

.changelog__group {
    margin: 14px 0 6px 0;
    padding: 0;
    color: rgb(150, 166, 188);
    font-size: 13px;
    letter-spacing: 4px;
    -unity-font-style: bold;
}

.changelog__line {
    flex-direction: row;
    align-items: flex-start;
    margin: 0 0 8px 0;
}

.changelog__dot {
    width: 5px;
    height: 5px;
    margin: 9px 12px 0 2px;
    border-radius: 3px;
    background-color: rgb(120, 180, 255);
    flex-shrink: 0;
}

.changelog__text {
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    color: rgb(214, 226, 240);
    font-size: 16px;
    white-space: normal;
}

.changelog__gap {
    height: 40px;
}
