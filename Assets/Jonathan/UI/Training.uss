/* training: the rules on the left and the bot on the right, the same height, start under them; the options look, wider */
.training-column {
    width: 1600px;
}

.training-cards {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 32px;
}

.training-card {
    width: 784px;
    padding: 32px 48px;
}

.training-card .option-row {
    border-bottom-width: 0;
}

/* the card's name over its rows */
.card-heading {
    margin: 0 0 8px 0;
    padding: 0 0 16px 0;
    border-bottom-width: 2px;
    border-color: rgba(255, 255, 255, 0.08);
    color: rgb(120, 140, 165);
    font-size: 16px;
    letter-spacing: 8px;
    -unity-font-style: bold;
}

.training-card .preset-dropdown .color-dropdown__field {
    width: 320px;
}

.training-card .option-slider {
    width: 320px;
}

.training-card .turn-time {
    width: 136px;
}

.training-footer {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    height: 72px;
    margin-top: 32px;
}
