/* training: the bot and the rules in one card, as tall as its rows, start under it */
.training-body {
    margin-top: 32px;
    padding: 32px 48px;
}

.training-body .option-row {
    border-bottom-width: 0;
}

.training-body .preset-dropdown .color-dropdown__field {
    width: 360px;
}

.training-body .option-slider {
    width: 400px;
}

.training-footer {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    height: 72px;
    margin-top: 32px;
}
