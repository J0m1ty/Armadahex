/* options: one page with audio and controls tabs; both tabs share the same header and body size so nothing moves */
.options {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.options-column {
    width: 1100px;
}

.options-title {
    margin: 0 0 24px 0;
    padding: 0;
    color: rgb(240, 246, 255);
    font-size: 40px;
    letter-spacing: 8px;
}

.options-tabs {
    flex-direction: row;
    border-bottom-width: 2px;
    border-color: rgba(255, 255, 255, 0.08);
}

.options-tabs > .tab {
    flex-grow: 0;
    width: 220px;
    margin-bottom: -2px;
}

.options-body {
    height: 640px;
    margin-top: 32px;
    padding: 32px 48px;
}

/* a setting: its name on the left, its control on the right */
.option-row {
    flex-direction: row;
    align-items: center;
    height: 72px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.option-name {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 20px;
    letter-spacing: 4px;
}

.option-slider {
    width: 520px;
    height: 28px;
    margin: 0;
}

.option-slider .unity-base-slider__input,
.option-slider .unity-base-slider__drag-container {
    height: 28px;
}

.option-slider .unity-base-slider__tracker {
    height: 4px;
    margin-top: -2px;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 0;
    border-radius: 0;
}

.option-slider .unity-base-slider__fill {
    background-color: var(--accent);
}

.option-slider .unity-base-slider__dragger {
    width: 14px;
    height: 28px;
    margin-top: -14px;
    background-color: var(--accent);
    border-width: 0;
    border-radius: 2px;
}

.option-slider .unity-base-slider__dragger-border {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* controls: every key in a list, each bound key drawn as a chip */
.options-body .controls-list {
    flex-grow: 1;
    width: auto;
}

.controls-list .row {
    height: 56px;
    padding: 0 8px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.controls-list .control-name {
    flex-grow: 1;
    width: auto;
    margin: 0;
    padding: 0;
    font-size: 20px;
    letter-spacing: 2px;
    -unity-font-style: normal;
}

.controls-list .control-name.h2 {
    font-size: 16px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    color: rgb(120, 140, 165);
}

.controls-list .control-key {
    width: auto;
    min-width: 72px;
    height: 36px;
    margin: 0;
    padding: 0 12px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgb(58, 74, 98);
    border-radius: 3px;
    color: rgb(214, 226, 240);
    font-size: 16px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    transition-duration: 0.15s;
}

.controls-list .control-key:hover {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--accent);
}

.controls-list .control-key.lit {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
}

/* under the card: reset sits at the right, and slides over to make room when there's something to save */
.options-footer {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    height: 56px;
    margin-top: 8px;
}

.options-footer > .reset {
    transition-duration: 0.2s;
}

.options-footer > .save {
    position: absolute;
    right: 0;
    width: 200px;
    height: 40px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgb(58, 74, 98);
    border-radius: 3px;
    color: rgb(214, 226, 240);
    font-size: 16px;
    letter-spacing: 4px;
    opacity: 0;
    visibility: hidden;
    transition-duration: 0.2s;
}

.options-footer > .save:hover {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--accent);
    color: var(--accent);
}

.options-footer.unsaved > .reset {
    translate: -232px 0;
}

.options-footer.unsaved > .save {
    opacity: 1;
    visibility: visible;
}

/* ON / OFF: a pill, the picked side filled in */
.switch {
    flex-direction: row;
    padding: 2px;
    border-width: 2px;
    border-color: rgb(58, 74, 98);
    border-radius: 18px;
}

.switch:hover {
    border-color: var(--accent);
}

.switch__side {
    width: 56px;
    height: 28px;
    margin: 0;
    padding: 0;
    border-radius: 14px;
    color: rgb(120, 140, 165);
    font-size: 15px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
}

.switch__side--picked {
    background-color: var(--accent);
    color: var(--accent-ink);
}

.controls-list .control-name.h2 {
    align-self: stretch;
    padding-bottom: 8px;
    -unity-text-align: lower-left;
}

.controls-list .unity-list-view__item,
.controls-list .unity-list-view__item:hover {
    background-color: rgba(0, 0, 0, 0);
}

/* a key bound to more than one action */
.controls-list .conflict {
    width: 24px;
    height: 24px;
    margin: 0 12px 0 0;
    padding: 0;
    border-radius: 12px;
    background-color: rgb(225, 75, 70);
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
