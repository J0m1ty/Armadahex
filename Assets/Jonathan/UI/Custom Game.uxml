<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Base.uss" />
    <ui:Style src="Theme.uss" />
    <ui:Style src="Options.uss" />
    <ui:Style src="CustomGame.uss" />
    <ui:VisualElement class="screen options">
        <Backdrop class="backdrop" />
        <ui:Button name="backButton" class="back">
            <KeyLabel action="UI/Cancel" format="{0}" picking-mode="Ignore" class="key-chip" />
            <ui:Label text="BACK" picking-mode="Ignore" class="back-text" />
        </ui:Button>
        <ui:VisualElement class="options-column">
            <ui:Label text="CUSTOM GAME" class="options-title" />
            <ui:VisualElement class="options-tabs">
                <ui:Button name="createTab" text="CREATE" focusable="false" class="tab lit" />
                <ui:Button name="joinTab" text="JOIN" focusable="false" class="tab" />
            </ui:VisualElement>
            <ui:VisualElement class="custom-body panel">
                <ui:VisualElement picking-mode="Ignore" class="panel-edge" />
                <ui:VisualElement name="createPage">
                    <ui:VisualElement class="option-row">
                        <ui:Label text="PRESET" class="option-name" />
                        <ListDropdown name="presets" class="preset-dropdown" />
                    </ui:VisualElement>
                    <ui:VisualElement class="option-row">
                        <ui:VisualElement class="option-label">
                            <ui:Label text="CAPTAIN ABILITIES" class="option-name" />
                            <InfoTip text="Each side plays with its captain&apos;s passive and special." />
                        </ui:VisualElement>
                        <Switch name="captains" />
                    </ui:VisualElement>
                    <ui:VisualElement class="option-row">
                        <ui:VisualElement class="option-label">
                            <ui:Label text="ADVANCED ATTACKS" class="option-name" />
                            <InfoTip text="Every ship gets its own powerful attacks." />
                        </ui:VisualElement>
                        <Switch name="advancedAttacks" />
                    </ui:VisualElement>
                    <ui:VisualElement name="unlimitedAmmoRow" class="option-row">
                        <ui:VisualElement class="option-label">
                            <ui:Label text="UNLIMITED AMMO" class="option-name" />
                            <InfoTip text="Advanced attacks never run out of ammo." />
                        </ui:VisualElement>
                        <Switch name="unlimitedAmmo" />
                    </ui:VisualElement>
                    <ui:VisualElement class="option-row">
                        <ui:VisualElement class="option-label">
                            <ui:Label text="SALVO SHOTS" class="option-name" />
                            <InfoTip text="Gain one shot for each ship you have left." />
                        </ui:VisualElement>
                        <Switch name="salvo" />
                    </ui:VisualElement>
                    <ui:VisualElement class="option-row">
                        <ui:VisualElement class="option-label">
                            <ui:Label text="BONUS SHOTS" class="option-name" />
                            <InfoTip text="Every hit earns another shot." />
                        </ui:VisualElement>
                        <Switch name="bonus" />
                    </ui:VisualElement>
                    <ui:VisualElement class="option-row">
                        <ui:Label text="TURN TIME" class="option-name" />
                        <ui:SliderInt name="turnTime" low-value="25" high-value="95" fill="true" class="option-slider turn-slider" />
                        <ui:Label name="turnTimeText" class="turn-time" />
                    </ui:VisualElement>
                    <ui:VisualElement class="option-row">
                        <ui:Label text="CHAT" class="option-name" />
                        <Switch name="allowChat" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="joinPage" class="join-page hidden">
                    <ui:Label text="CODE" class="join-title" />
                    <ui:VisualElement name="codeSlots" class="code-slots">
                        <ui:Label class="code-slot" />
                        <ui:Label class="code-slot" />
                        <ui:Label class="code-slot" />
                        <ui:Label class="code-slot" />
                        <ui:TextField name="joinCode" max-length="4" class="code-input" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="custom-footer">
                <ui:VisualElement name="copy" class="room-code invisible">
                    <ui:Label name="code" picking-mode="Ignore" class="room-code__value" />
                    <CopyIcon picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Button name="create" text="CREATE" class="action" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
