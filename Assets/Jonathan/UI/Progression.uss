/* progression: the highlighted captain's card and the library above, the player's stats along the bottom */
.progression {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.progression-body {
    position: absolute;
    left: 56px;
    right: 56px;
    top: 216px;
    bottom: 56px;
}

.progression-top {
    flex-grow: 1;
    flex-direction: row;
}

/* the captain's card */
.captain-card {
    width: 520px;
    margin-right: 40px;
    padding: 32px;
    -unity-background-image-tint-color: rgba(24, 36, 62, 0.97);
}

.captain-card > .panel-edge {
    -unity-background-image-tint-color: rgba(200, 220, 255, 0.32);
}

.captain-card__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
}

.captain-card__portrait {
    width: 112px;
    height: 112px;
    margin-right: 24px;
}

.captain-card__portrait > .captain-initials {
    font-size: 44px;
}

.captain-name {
    margin: 0;
    padding: 0;
    color: rgb(240, 246, 255);
    font-size: 32px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.captain-epithet {
    margin: 4px 0 0 0;
    padding: 0;
    color: rgb(120, 140, 165);
    font-size: 15px;
    letter-spacing: 6px;
}

.captain-ability {
    margin-bottom: 20px;
}

.captain-ability__kind {
    margin: 0;
    padding: 0;
    color: rgb(120, 140, 165);
    font-size: 13px;
    letter-spacing: 6px;
    -unity-font-style: bold;
}

.captain-ability__name {
    margin: 4px 0 0 0;
    padding: 0;
    color: rgb(240, 246, 255);
    font-size: 21px;
    -unity-font-style: bold;
}

.captain-ability__text {
    margin: 4px 0 0 0;
    padding: 0;
    color: rgb(170, 186, 206);
    font-size: 17px;
    white-space: normal;
}

.captain-card__foot {
    flex-grow: 1;
    justify-content: flex-end;
}

/* where an earned captain comes from: a lock while it's still locked, the source and the exact requirement */
.captain-source {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
    padding: 16px;
    background-color: rgba(0, 0, 0, 0.25);
}

.captain-source__lock {
    width: 20px;
    height: 26px;
    margin-right: 16px;
    color: rgb(120, 140, 165);
}

.captain-source__kind {
    margin: 0;
    padding: 0;
    color: rgb(120, 140, 165);
    font-size: 13px;
    letter-spacing: 6px;
    -unity-font-style: bold;
}

.captain-source__requirement {
    margin: 4px 0 0 0;
    padding: 0;
    color: rgb(240, 246, 255);
    font-size: 18px;
    white-space: normal;
}

.captain-active {
    height: 64px;
    margin: 0;
    padding: 0;
    color: rgb(240, 246, 255);
    font-size: 22px;
    letter-spacing: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.captain-action {
    height: 64px;
    font-size: 22px;
    letter-spacing: 8px;
    -unity-slice-scale: 0.5px;
}

.captain-card--locked .captain-card__portrait,
.captain-card--locked .captain-name {
    opacity: 0.45;
}

/* a portrait, or initials on a dark square until there's one */
.captain-portrait {
    align-items: center;
    justify-content: center;
    background-color: rgb(20, 30, 52);
    -unity-background-scale-mode: scale-and-crop;
}

.captain-initials {
    margin: 0;
    padding: 0;
    color: rgb(120, 140, 165);
    font-size: 36px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

/* the library: small tiles that wrap and scroll up and down */
.captain-grid {
    flex-grow: 1;
}

.captain-grid .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
}

.captain-tile {
    width: 18%;
    margin: 0 2% 24px 0;
}

.captain-tile__portrait {
    height: 200px;
    border-width: 3px;
    border-color: rgb(34, 46, 66);
    transition-duration: 0.15s;
}

.captain-tile:hover > .captain-tile__portrait {
    border-color: rgb(120, 140, 165);
}

.captain-tile.lit > .captain-tile__portrait {
    border-color: var(--accent);
}

.captain-tile__name {
    margin: 10px 0 0 0;
    padding: 0;
    color: rgb(214, 226, 240);
    font-size: 16px;
    letter-spacing: 2px;
}

.captain-tile--locked .captain-initials,
.captain-tile--locked .captain-tile__name {
    opacity: 0.4;
}

.captain-tile__lock {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 16px;
    height: 21px;
    color: rgb(120, 140, 165);
}

.captain-tile--unlockable .captain-tile__portrait {
    border-color: rgb(150, 170, 200);
}

.captain-tile__tag {
    position: absolute;
    left: 10px;
    top: 10px;
    min-width: 0;
    padding: 1px 8px;
    font-size: 12px;
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
}

/* stats: three columns along the bottom */
.progression-stats {
    flex-direction: row;
    margin-top: 32px;
}

.stat-group {
    flex-grow: 1;
    flex-basis: 0;
}

.stat-group--middle {
    margin: 0 48px;
}

