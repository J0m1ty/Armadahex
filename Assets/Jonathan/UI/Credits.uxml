<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Jonathan/UI/Base.uss?fileID=7433441132597879392&amp;guid=b5a44b40eb90f1741a8fbe41765e4d07&amp;type=3#Base"/>
    <Style src="project://database/Assets/Jonathan/UI/Theme.uss?fileID=7433441132597879392&amp;guid=a20a5efdaf552f84b94acbaf1eb4b9b6&amp;type=3#Theme"/>
    <Style src="project://database/Assets/Jonathan/UI/Credits.uss?fileID=7433441132597879392&amp;guid=e277a7125b61143498572338ef293e8d&amp;type=3#Credits"/>
    <ui:VisualElement class="screen">
        <Backdrop class="backdrop"/>
        <ui:ScrollView name="credits" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="roll">
            <ui:VisualElement class="credits-logo">
                <ui:Label name="logoText" text="ARMADAHEX" class="logo-text"/>
                <LightStreak target="logoText" peak-text="HEX" class="streak"/>
            </ui:VisualElement>
            <ui:Label text="DEVELOPMENT TEAM" class="credit-section"/>
            <ui:Label text="PROJECT LEAD" class="credit-role"/>
            <ui:Label text="Jonathan Schultz" class="credit-name"/>
            <ui:Label text="PROJECT CO-LEADS" class="credit-role"/>
            <ui:Label text="Nick Ward &amp; David Smith" class="credit-name"/>
            <ui:Label text="SHADER PROGRAMMER" class="credit-role"/>
            <ui:Label text="Kyle Diehm" class="credit-name"/>
            <ui:Label text="SOUNDTRACK PRODUCER" class="credit-role"/>
            <ui:Label text="Juniper Lasky" class="credit-name"/>
            <ui:Label text="VOICE ANNOUNCER" class="credit-role"/>
            <ui:Label text="Justin Roof" class="credit-name"/>
            <ui:Label text="LOGO DESIGNER" class="credit-role"/>
            <ui:Label text="Zoe Wilson" class="credit-name"/>
            <ui:Label text="SOUND FX CURATOR" class="credit-role"/>
            <ui:Label text="Jeremy Dale" class="credit-name"/>
            <ui:Label text="SPECIAL THANKS" class="credit-section"/>
            <ui:Label text="PANEL MEMBERS" class="credit-role"/>
            <ui:Label text="Will McLaughlin" class="credit-name"/>
            <ui:Label text="Rick Cook" class="credit-name"/>
            <ui:Label text="Amy McGowan" class="credit-name"/>
            <ui:Label text="David Ghidiu" class="credit-name"/>
            <ui:Label text="Jeff Kidd" class="credit-name"/>
            <ui:Label text="ASSOCIATE PROFESSOR" class="credit-role"/>
            <ui:Label text="Paul Engin" class="credit-name"/>
            <ui:Label text="DEGREE PROGRAM" class="credit-section"/>
            <ui:Label text="Submitted in partial fulfillment of Associate in Science Degree" class="credit-note"/>
            <ui:Label text="Game Programming and Design: CSC 256" class="credit-note"/>
            <ui:Label text="Finger Lakes Community College" class="credit-note"/>
            <ui:Label text="3325 Marvin Sands Drive" class="credit-note"/>
            <ui:Label text="Canandaigua, NY 14424" class="credit-note"/>
        </ui:ScrollView>
        <ui:Button name="done" class="back">
            <KeyLabel action="UI/Cancel" format="{0}" picking-mode="Ignore" class="key-chip"/>
            <ui:Label text="BACK" picking-mode="Ignore" class="back-text"/>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
