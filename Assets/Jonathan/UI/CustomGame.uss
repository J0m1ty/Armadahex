/* custom game: the options layout with create and join tabs; both tabs share one body size, and the button under it does what the tab says */
.custom-body {
    height: 640px;
    margin-top: 32px;
    padding: 32px 48px;
}

.custom-body .option-row {
    border-bottom-width: 0;
}

.preset-dropdown .color-dropdown__field {
    width: 360px;
}

/* while there's a room the rules stay readable, the whole page a little dimmer */
#createPage:disabled {
    opacity: 0.6;
}

#createPage *:disabled {
    opacity: 1;
}

#createPage .unavailable > .switch:disabled {
    opacity: 0.35;
}

/* join: the code's four characters in their own slots, each underlined; the field itself is invisible on top */
.join-page {
    flex-grow: 1;
    align-self: center;
    justify-content: center;
}

.join-title {
    align-self: flex-start;
    margin: 0 0 16px 0;
    padding: 0;
    color: rgb(120, 140, 165);
    font-size: 20px;
    letter-spacing: 8px;
    -unity-font-style: bold;
}

.code-slots {
    flex-direction: row;
    padding: 16px 32px 32px 32px;
    border-width: 2px;
    border-color: rgb(58, 74, 98);
    border-radius: 3px;
    transition-duration: 0.15s;
}

.code-slots:hover {
    border-color: rgb(120, 140, 165);
}

.code-slots.focused {
    border-color: var(--accent);
}

.code-slot {
    width: 104px;
    height: 128px;
    margin: 0 12px;
    padding: 0;
    border-bottom-width: 3px;
    border-color: rgb(58, 74, 98);
    color: rgb(240, 246, 255);
    font-size: 80px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
}

.code-slots:hover > .code-slot {
    border-color: rgb(120, 140, 165);
}

.code-slots.focused > .code-slot--current,
.code-slots.focused > .code-slot--filled {
    border-color: var(--accent);
}

.code-input {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    opacity: 0;
}

.code-input > .unity-base-text-field__input {
    height: 100%;
}

/* while there's a room the tabs stay put but read as off, except the picked one */
.options-tabs > .tab:disabled {
    opacity: 1;
    color: rgb(58, 74, 98);
}

.options-tabs > .tab.lit:disabled {
    color: rgb(240, 246, 255);
}

/* under the body: the room's code on the left once there is one, the button on the right */
.custom-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 72px;
    margin-top: 32px;
}

/* the room's code, set apart on its own block so it reads as something to hand over */
.room-code {
    flex-direction: row;
    align-items: center;
    height: 72px;
    padding: 0 24px 0 32px;
    background-color: rgba(255, 255, 255, 0.06);
    border-left-width: 3px;
    border-color: var(--accent);
}

.room-code__value {
    width: 200px;
    margin: 0;
    padding: 0;
    color: rgb(240, 246, 255);
    font-size: 40px;
    letter-spacing: 16px;
    -unity-font-style: bold;
}

.copy-icon {
    width: 22px;
    height: 22px;
    margin-left: 16px;
    translate: 0 -2px;
    color: rgb(120, 140, 165);
    transition-duration: 0.15s;
}

.room-code:hover > .copy-icon {
    color: var(--accent);
}

/* while it makes or joins a room it goes dark like the code box and shows how long; an error turns it red */
.action.search-busy {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(240, 246, 255);
}

.action.search-busy:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.action.search-error,
.action.search-error:disabled {
    background-color: rgb(150, 48, 44);
    color: rgb(255, 235, 232);
}
